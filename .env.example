# Copy this file to .env and fill in your own values.
# .env is private and must never be committed.
# Write each value on the same line as its name. Do not add comments after a value.

# local = XAMPP on this computer. production = real hosting.
APP_ENV=local

# 64 random hex characters. Generate one with:
#   php -r "echo bin2hex(random_bytes(32));"
# Do not change it after users have saved vault passwords, or they become unreadable.
VAULT_ENCRYPTION_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=squirdb
DB_USER=root
DB_PASS=

# Gmail address and a Gmail App Password (not your normal password).
SMTP_USERNAME=
SMTP_PASSWORD=

# true shows reset codes on screen if email fails. Only works with APP_ENV=local
# and only for requests from the same computer. Keep false everywhere else.
MAIL_DEV_FALLBACK=false

# true logs the full SMTP conversation (including codes) to includes/logs/mail-debug.log.
# Only works with APP_ENV=local.
MAIL_DEBUG=false
